# Copiar este archivo a ".env" y completar con los valores reales de tu proyecto Supabase.
# NUNCA subir el archivo ".env" (con las claves reales) a git ni compartirlo.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY_AQUI
RESEND_API_KEY=TU_RESEND_API_KEY_AQUI
REPORTE_EMAIL_DESTINO=tu-mail@ejemplo.com
# Para mandarlo a más de una persona, separá los mails con coma:
# REPORTE_EMAIL_DESTINO=vos@ejemplo.com, socio@ejemplo.com
